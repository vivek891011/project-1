additionalTrustBundlePolicy: Proxyonly
apiVersion: v1
baseDomain: mahity.local
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform: {}
  replicas: 0                    #### should be zero 
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform: {}
  replicas: 3
metadata:
  creationTimestamp: null
  name: ocp-vivek
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 192.168.10.0/24                          ##### should be change with your server ip 
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  vsphere:
    apiVIPs:                                      ### should be delete 
    - 192.168.10.58                              ### also delete 
    failureDomains:
    - name: generated-failure-domain
      region: generated-region
      server: vcenter.mahity.local
      topology:
        computeCluster: /mahitydc/host/cluster-vivek
        datacenter: mahitydc
        datastore: /mahitydc/datastore/esxi3-ds2
        networks:
        - VM Network
        resourcePool: /mahitydc/host/cluster-vivek/Resources
      zone: generated-zone
    ingressVIPs:                               ## delete
    - 192.168.10.59                              ### also delete 
    vcenters:
    - datacenters:
      - mahitydc
      password: Mahity@123
      port: 443
      server: vcenter.mahity.local
      user: administrator@mahity.local
publish: External
